  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3a808a838f07f6468ea1f49b39428c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  paragraphText: {fileID: 62067401}
  audioController: {fileID: 937046196}
  audioSource: {fileID: 0}
  paragraphs:
  - "Ahora s\xED, subimos el ritmo: 3x\xB2 + 6x. No te asust\xE9s, que esto es puro
    swing"
  hintParagraphs:
  - "Aqu\xED no solo se repite un n\xFAmero\u2026 tambi\xE9n hay una x en ambos t\xE9rminos.
    \xBFLa ves?"
  - "Junt\xE1 lo com\xFAn: 3 y x. Sacalos 3x por fuera y divid\xED cada t\xE9rmino
    pa\u2019 llenar el par\xE9ntesis."
  closureParagraph: "\xA1Qu\xE9 nota! Cuando ves n\xFAmero y letra en com\xFAn, todo
    queda m\xE1s fino."
